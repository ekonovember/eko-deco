{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONPATH": "src"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Skill",
      "Agent",
      "WebFetch"
    ]
  }
}
